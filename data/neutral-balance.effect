uniform float4x4 ViewProj;
uniform texture2d image;

/* 3x3 chromatic-adaptation matrix, uploaded as rows (float3) so the shader
 * works on every OBS >= 28 regardless of float3x3 uniform support. */
uniform float3 cat_row0;
uniform float3 cat_row1;
uniform float3 cat_row2;
uniform float ws_mode;   /* 0 = sRGB transfer, 1 = BT.709 transfer */
uniform float split_pos; /* > 0: left fraction of the frame shows the input */

sampler_state linear_sampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData mainvertex(VertData v)
{
	VertData o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.uv = v.uv;
	return o;
}

/* ---- Stage 1/3 helpers: transfer functions of the working space -------- */

float3 srgb_to_linear(float3 c)
{
	c = saturate(c);
	float3 lo = c / 12.92;
	float3 hi = pow((c + 0.055) / 1.055, 2.4);
	return lerp(lo, hi, step(0.04045, c));
}

float3 linear_to_srgb(float3 c)
{
	float3 lo = c * 12.92;
	float3 hi = 1.055 * pow(c, 1.0 / 2.4) - 0.055;
	return lerp(lo, hi, step(0.0031308, c));
}

float3 bt709_to_linear(float3 c)
{
	c = saturate(c);
	float3 lo = c / 4.5;
	float3 hi = pow((c + 0.099) / 1.099, 1.0 / 0.45);
	return lerp(lo, hi, step(0.081, c));
}

float3 linear_to_bt709(float3 c)
{
	float3 lo = c * 4.5;
	float3 hi = 1.099 * pow(c, 0.45) - 0.099;
	return lerp(lo, hi, step(0.018, c));
}

float3 decode_to_linear(float3 c)
{
	return ws_mode < 0.5 ? srgb_to_linear(c) : bt709_to_linear(c);
}

float3 encode_from_linear(float3 c)
{
	return ws_mode < 0.5 ? linear_to_srgb(c) : linear_to_bt709(c);
}

/* ---- Combined pixel shader: the three PRD stages in one pass ----------- */

float4 mainpixel(VertData v) : SV_Target
{
	float4 c = image.Sample(linear_sampler, v.uv);
	if (split_pos > 0.0 && v.uv.x < split_pos)
		return c;

	/* Stage 1: the OBS GPU path already delivered full-range RGB (FR-07);
	 * linearize with the detected working space's inverse EOTF (FR-09). */
	float3 lin = decode_to_linear(c.rgb);

	/* Stage 2: full chromatic-adaptation transform (FR-14..FR-18). */
	float3 corrected = float3(dot(cat_row0, lin), dot(cat_row1, lin), dot(cat_row2, lin));

	/* Stage 3: forward EOTF back to the source encoding (FR-17). */
	c.rgb = saturate(encode_from_linear(corrected));
	return c;
}

technique Draw
{
	pass
	{
		vertex_shader = mainvertex(v);
		pixel_shader = mainpixel(v);
	}
}
